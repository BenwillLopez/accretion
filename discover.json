{
  "_comment": "Where discover.py looks for new sources. Every URL found is checked; only real AltStore/SideStore sources are kept.",
  "pages": [
    "https://raw.githubusercontent.com/victordedomenico/awesome-altstore/main/README.md",
    "https://raw.githubusercontent.com/luh-99/SideStoreAndAltStore-Sources/main/README.md",
    "https://raw.githubusercontent.com/RipeStore/repos/main/README.md",
    "https://senumy.com/altstore-and-sidestore-sources",
    "https://onejailbreak.com/blog/altstore-sources/",
    "https://idevicecentral.com/repos/top-10-altstore-sources-and-repos-to-add-in-2023/"
  ],
  "github_repos": [
    "RipeStore/repos",
    "luh-99/SideStoreAndAltStore-Sources",
    "quarksources/quarksources.github.io",
    "SideStore/apps.json",
    "WSF-Team/WSF"
  ],
  "github_topics": [
    "altstore-repo",
