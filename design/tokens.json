{
  "_about": "The one source of Accretion's look. scripts/design_tokens.py writes the colour block at the top of site/style.css and the app's AccretionTokens.swift from this file. Edit here, then run: python scripts/design_tokens.py --app ../accretion-app",
  "colors": {
    "bg": { "dark": "#07070D", "light": "#F7F6FC" },
    "surface": { "dark": "#0F0E1A", "light": "#FFFFFF" },
    "raised": { "dark": "#17152A", "light": "#F0EEF9" },
    "line": { "dark": "#262145", "light": "#DFDAF2" },
    "fg": { "dark": "#ECEAFF", "light": "#15122B" },
    "muted": { "dark": "#8B87B3", "light": "#625E85" },
    "accent": { "dark": "#8B5CF6", "light": "#6D3FE0" },
    "accent-2": { "dark": "#22D3EE", "light": "#0E8FB0" },
    "on-accent": { "dark": "#FFFFFF" },
    "good": { "dark": "#34D399", "light": "#078A5E" },
    "warn": { "dark": "#F59E0B", "light": "#B76A00" },
    "bad": { "dark": "#F87171", "light": "#C2410C" }
  },
  "glow": { "dark": 16, "light": 9 },
  "grid": {
    "size": 28,
    "dark": { "rgb": [255, 255, 255], "alpha": 0.035 },
    "light": { "rgb": [30, 27, 75], "alpha": 0.05 }
  },
  "fonts": {
    "display": "\"Sora\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "body": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "radius": 14
}
